    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data || '';\n\n// 1. Extract the form submission URL (/formResponse)\nconst actionMatch = html.match(/action=\"(https:\\/\\/docs\\.google\\.com\\/forms\\/[^\"]+\\/formResponse)\"/);\nconst rawUrl = $('Get Form HTML').first().json.url || '';\nconst fallbackUrl = rawUrl.replace(/\\/viewform.*$/, '/formResponse');\nconst submitUrl = actionMatch ? actionMatch[1] : fallbackUrl;\n\n// 2. Extract Google Forms internal FB_PUBLIC_LOAD_DATA_ array\nconst dataMatch = html.match(/FB_PUBLIC_LOAD_DATA_\\s*=\\s*(\\[\\s*null[\\s\\S]*?\\]);\\s*<\\/script>/);\nif (!dataMatch) {\n  throw new Error('Could not find Google Form fields. Make sure the link is a public Google Form /viewform URL.');\n}\n\nconst rawData = JSON.parse(dataMatch[1]);\nconst questionsRaw = (rawData[1] && rawData[1][1]) ? rawData[1][1] : [];\n\nconst typeMap = {\n  0: 'Short Subjective Answer',\n  1: 'Paragraph Subjective Answer',\n  2: 'Multiple Choice (Radio Button - Pick 1)',\n  3: 'Dropdown (Pick 1)',\n  4: 'Checkboxes (Multi-Select)',\n  7: 'Match the Columns / Grid (Pick 1 column per row)'\n};\n\nconst parsedFields = [];\n\nfor (const q of questionsRaw) {\n  const questionTitle = q[1];\n  const questionType = q[3];\n  const entries = q[4];\n\n  if (!entries || !Array.isArray(entries)) continue;\n\n  for (const entry of entries) {\n    const entryId = `entry.${entry[0]}`;\n    const rowLabel = (entry[3] && entry[3][0]) ? entry[3][0] : null;\n    const optionsRaw = entry[1] || [];\n    const validOptions = optionsRaw\n      .map(opt => opt[0])\n      .filter(opt => opt !== null && opt !== undefined && opt !== '');\n\n    parsedFields.push({\n      entry_id: entryId,\n      question: questionTitle,\n      row_to_match: rowLabel,\n      input_type: typeMap[questionType] || 'Text Input',\n      available_choices: validOptions.length > 0 ? validOptions : 'Write a subjective text answer'\n    });\n  }\n}\nconst fbzxMatch = html.match(/name=\"fbzx\"\\s+value=\"([^\"]+)\"/);\nconst fbzx = fbzxMatch ? fbzxMatch[1] : '';\nreturn [{\n  json: {\n    submit_url: submitUrl,\n    fbzx: fbzx,\n    total_fields: parsedFields.length,\n    form_fields: parsedFields\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "5d856c20-1081-4f64-9314-11f8150a319c",
      "name": "Extract Form Schema"
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.text || $input.first().json.output || '{}';\nconst cleanJsonText = rawText.replace(/```json/gi, '').replace(/```/g, '').trim();\nconst answers = JSON.parse(cleanJsonText);\n\nconst params = new URLSearchParams();\n\nfor (const [entryKey, value] of Object.entries(answers)) {\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      params.append(entryKey, String(item));\n    }\n  } else if (value !== null && value !== undefined) {\n    params.append(entryKey, String(value));\n  }\n}\n\n// Required Google Form state parameters\nparams.append('fvv', '1');\nparams.append('pageHistory', '0');\nconst fbzxToken = $('Extract Form Schema').first().json.fbzx;\nif (fbzxToken) {\n  params.append('fbzx', fbzxToken);\n}\n\nreturn [{\n  json: {\n    submit_url: $('Extract Form Schema').first().json.submit_url,\n    submitted_answers: answers,\n    urlencoded_body: params.toString()\n  }\n}];"
      },
