        "promptType": "define",
        "text": "=Solve every question and map the exact answers to their Google Form entry IDs.\n\nForm Fields Schema:\n{{ JSON.stringify($json.form_fields, null, 2) }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You are an automated form-filling engine. You will receive a JSON list of Google Form fields (`entry_id`, `question`, `row_to_match`, `input_type`, and `available_choices`).\n\nYOUR RULES:\n1. Solve every question accurately.\n2. For Radio Buttons, Dropdowns, and Match the Columns / Grid (`row_to_match`), your answer MUST be an exact character-for-character match to one string in `available_choices`.\n3. For Checkboxes (Multi-Select), output an array of exact matching strings from `available_choices`.\n4. For Subjective Answers, write a clear, complete, academic answer.\n5. Output ONLY a raw JSON object where keys are the `entry_id` (e.g. \"entry.123456\") and values are the selected answer(s). Do NOT include markdown formatting or explanations."
            }
          ]
        },
